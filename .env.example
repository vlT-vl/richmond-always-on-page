# Public base path of the app
VITE_BASE_URL=/

# Debug replay button (restarts the whole sequence in place, without reloading); set to false or remove to hide
VITE_DEBUG_REPLAY=false

# Seconds between two full restarts of the page (exit animation, theme switch, entrance from the beginning).
# Empty or 0 = no loop (there is no default in the code).
VITE_LOOP_SECONDS=180

# Team carousel, after the entrance sequence ends: seconds on the full page before the first card expands,
# seconds each person's card takes in total (0 or empty = no carousel),
# seconds of pause between one round of cards and the next.
VITE_TEAM_CAROUSEL_START_DELAY_SECONDS=5
VITE_TEAM_CARD_DURATION_SECONDS=23
VITE_TEAM_CAROUSEL_PAUSE_SECONDS=20

# Seconds between two changes of the slot shown by the top-left agenda pill (empty or 0 = no rotation)
VITE_PILL_INTERVAL_SECONDS=15

# Welcome card: seconds the card stays in each of its two layouts (attendee name / company with name, role and time) before it
# animates to the other one, back and forth (empty or 0 = it never swaps)
VITE_WELCOME_SWAP_SECONDS=30

# Fullscreen button visible and clickable from the very first frame of the entrance sequence, not only once the top bar enters
# (true = always visible; anything else = it enters with the top bar like the other buttons)
VITE_FULLSCREEN_ALWAYS_VISIBLE=true
